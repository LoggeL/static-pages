// Cathrin Raasch Atelier – Website + Shop auf Cloudflare Workers.
// Statische Dateien kommen direkt aus public/floraundgrete (dieselben wie auf GitHub Pages).
// Der Worker läuft nur für /api/* und die Startseite (dort setzt er die veröffentlichten Inhalte ins HTML).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floraundgrete",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../public/floraundgrete",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  // Datenbank: Inhalte, Artikel, Bestellungen, Reservierungen, verarbeitete Stripe-Ereignisse.
  // Vor dem ersten Deploy: `npx wrangler d1 create floraundgrete` und die ausgegebene ID hier eintragen.
  "d1_databases": [
    { "binding": "DB", "database_name": "floraundgrete", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Fotos, die Cathrin in der Verwaltung hochlädt (Shop und Galerie)
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "floraundgrete-bilder" }],
  // Schutz gegen Bots: Kasse/Anfragen 10 pro Minute, Anmeldung 5 pro Minute (je IP)
  "ratelimits": [
    { "name": "CHECKOUT_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "4102", "simple": { "limit": 5, "period": 60 } }
  ],
  // Alle 15 Minuten: abgelaufene Kassen-Reservierungen freigeben
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // Öffentlicher Turnstile-Schlüssel (Bot-Schutz an der Kasse); leer = aus
    "TURNSTILE_SITEKEY": ""
  },
  "observability": { "enabled": true }
}
